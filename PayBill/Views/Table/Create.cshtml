@{
}

<h1>Create Spending</h1>

<form asp-action="Create" method="post">
    <!-- Dish Name -->
    <div class="form-group">
        <label asp-for="NameTable" class="control-label"></label>
        <input asp-for="NameTable" class="form-control" />
        <span asp-validation-for="NameTable" class="text-danger"></span>
    </div>
    <!-- Submit Button -->
    <div class="form-group">
        <input type="submit" value="Submit" class="btn btn-primary" />
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
