@model PayBill.Models.GetDataToViewModel;

@using X.PagedList.Mvc.Core;
@{
    ViewData["Title"] = "Privacy Policy";
}

<link rel="stylesheet" href="~/css/Booking.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/site.css" />
<style>
    /* CSS cho popup hóa đơn */
    .invoice-popup {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background-color: rgba(0, 0, 0, 0.5); /* Màu nền mờ */
        display: none;
        justify-content: center;
        align-items: center;
        z-index: 1000; /* Đảm bảo popup xuất hiện trên các phần tử khác */
    }

    .invoice-box {
        background-color: white;
        padding: 20px;
        border-radius: 5px;
        width: 80%;
        max-width: 900px;
        overflow-y: auto;
    }
</style>
<div>
    <div class="con">
        <asp:Label class="lblMesSuc animeSuc" Visible="false"></asp:Label>
    </div>
    <h1>Danh sách bàn</h1>
    <table id="dataGrid" class="dataGrid">
        <thead>
            <tr>
                <th onclick="sortTable(0)">ID</th>
                <th onclick="sortTable(1)">Bàn</th>
                <th onclick="sortTable(2)">Chi tiết</th>
            </tr>
        </thead>
        <tbody>
            @for (int i = 0; i < Model.tablesList.Count(); i++)
            {
                var tableClass = "dataGridPopup" + i;
                var desk = @Html.DisplayFor(modelItem => Model.tablesList[i].NameTable);
                var id = @Html.DisplayFor(modelItem => Model.tablesList[i].ID);
                <tr>
                    <td>@Html.DisplayFor(modelItem => Model.tablesList[i].ID)</td>
                    <td>@Html.DisplayFor(modelItem => Model.tablesList[i].NameTable)</td>
                    <td><button id="tbl" type="button" class="button" onclick="openPopup('@tableClass', '@desk');" data-table="@id">Chi tiết</button></td>
                </tr>
            }
        </tbody>
    </table>
</div>

<div class="backdrop" id="backdrop" onclick="closePopup()">
    <h3 class="titleBackdrop"></h3>
</div>
<div class="conErr">
    <asp:Label class="lblMesErr animeErr" Visible="false"></asp:Label>
</div>

<div class="popup" id="popup">
    @for (int i = 0; i < Model.tablesList.Count(); i++)
    {
        var tableClass = "dataGridPopup" + i;
        <table id="dataGridPopup" class="@tableClass" style="width: 100%;">
            <thead class="thead-light">
                <tr>
                    <th onclick="sortTablePopup(0)">ID</th>
                    <th onclick="sortTablePopup(1)">Tên món</th>
                    <th onclick="sortTablePopup(2)">Giá</th>
                    <th onclick="sortTablePopup(3)">Số lượng</th>
                    <th onclick="sortTablePopup(4)">Thành tiền</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.dishesList)
                {
                    <tr>
                        <td>@Html.DisplayFor(modelItem => item.ID_Dish)</td>
                        <td>@Html.DisplayFor(modelItem => item.Dish_Name)</td>
                        <td><span class="price">@Html.DisplayFor(modelItem => item.Dish_Price)</span>đ</td>
                        <td>
                            <div class="counter-container">
                                <button class="decrement">-</button>
                                <span class="number">0</span>
                                <button class="increment">+</button>
                            </div>
                        </td>
                        <td><span class="total">0</span>đ</td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr>
                    <td class="left"></td>
                    <td class="center"></td>
                    <td class="center"></td>
                    <td class="right">Tổng thanh toán</td>
                    <td><span class="bill" id="total-bill">0</span>đ</td>
                </tr>
                <tr>
                    <td colspan="4" class="right">Thuế VAT (10%)</td>
                    <td>
                        <input type="checkbox" class="vat-check-box" />
                        <span id="vatAmount">0</span>đ
                    </td>
                </tr>
                <tr>
                    <td class="pay">
                        <input type="hidden" id="htmlInput" name="html" value="" />
                        <input type="hidden" id="billInput" name="billInput" value="">
                        <input type="hidden" id="idTable" name="idTable" value="">
                        <input type="hidden" id="paymentMethod" name="paymentMethod" value="">
                    </td>
                    <td class="pay"></td>
                    <td class="pay">
                        <button class="view-invoice" type="button" data-table="@i" style="text-align: right;">Xem trước Hóa Đơn</button>
                    </td>
                    <td class="paymentMethods">
                        <div class="divMethod">
                            <div id="1" class="chose fa-solid fa-wallet"><p class="hover-content">Tiền mặt</p></div>
                            <div id="2" class="chose fa-solid fa-money-bill-wave"><p class="hover-content">Chuyển khoản</p></div>
                            <div id="3" class="chose fa-regular fa-credit-card"><p class="hover-content">Credit Card</p></div>
                        </div>
                    </td>
                    <td class="pay"><button id="pay" type="submit" class="button" style="text-align: right;" data-table="@i">Thanh toán</button></td>
                </tr>
            </tfoot>
        </table>
    }
</div>

<!-- Popup để hiển thị hóa đơn -->
<div id="invoice-popup" class="invoice-popup" style="display: none;">
    <div class="invoice-box">
        <table cellpadding="0" cellspacing="0">
            <thead>
                <tr class="top">
                    <td colspan="2">
                        <table>
                            <tr>
                                <td>
                                    Payment Method: 
                                    Created: <strong>@DateTime.Now.ToString("dd/MM/yyyy")</strong><br />
                                </td>
                            </tr>
                        </table>
                    </td>
                </tr>
                <tr class="heading">
                    <td style="width: 10%;">Index</td>
                    <td style="width: 40%;">Item</td>
                    <td style="width: 10%;">Quantity</td>
                    <td style="width: 15%;">Price</td>
                    <td style="width: 25%;">Total Price</td>
                </tr>
            </thead>
            <tbody id="invoice-items">
                <!-- Các món ăn đã chọn sẽ được thêm vào đây -->
            </tbody>
            <tr class="total">
                <td colspan="4"></td>
                <td>Total: <strong id="total-amount">0</strong>đ</td>
            </tr>
        </table>
        <button onclick="printInvoice()" style="margin: 20px; padding: 10px 20px; background-color: #4CAF50; color: white; border: none; cursor: pointer;">In hóa đơn</button>
    </div>
</div>
<script>
    function printInvoice() {
        window.print();
    }
</script>


<!-- Button to navigate to Create page -->
<a asp-action="Create" class="button mt-3">Thêm Bàn</a>

<script src="~/js/Booking.js" asp-append-version="true"></script>