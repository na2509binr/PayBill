@model PayBill.Models.GetDataToViewModel;

@using X.PagedList.Mvc.Core;
@{
    ViewData["Title"] = "Privacy Policy";
}
<head>
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.3.1/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
    <link rel="stylesheet" href="~/css/History.css">
</head>



<div>
    @if (!string.IsNullOrEmpty(Model.message))
    {
        <div class="con">
            <asp:Label class="lblMesDataGrid" Visible="false">@Html.DisplayFor(modelItem => Model.message)</asp:Label>
        </div>
    }
    <h1>Tra cứu hóa đơn</h1>
    <ul class="nav nav-tabs tagBar">
        <li class="nav-item">
            <p class="nav-link active" id="1">Hóa đơn</p>
        </li>
        <li class="nav-item">
            <p class="nav-link" id="2">Hóa đơn nhân viên</p>
        </li>
    </ul>

    <br />

    <!-- Container bao bọc các bảng để tạo hiệu ứng slide -->
    <div class="carouselContainer">
        <div class="carouselTables show" id="t1">
            <div class="form-group row">
                <div class="col-sm-4">
                    <label for="fromdte" class="col-form-label">Từ ngày</label>
                    <input type="text" class="form-control" id="fromdte" name="fromdte" placeholder="Select date" required>
                </div>
                <div class="col-sm-4">
                    <label for="todte" class="col-form-label">Đến ngày</label>
                    <input type="text" class="form-control" id="todte" name="todte" placeholder="Select date" required>
                </div>
                <div class="col-sm-4">
                    <!-- Empty column for alignment -->
                </div>
            </div>
            <div class="text-center">
                <button type="submit" class="btn btn-primary" style="margin-bottom: 10px;" onclick="fillterDate('t1', 'table1');">Tìm kiếm</button>
            </div>

            <table class="table" id="table1">
                <thead class="thead-dark">
                    <tr>
                        <th onclick="sortTable(0)" class="center">Mã hóa đơn</th>
                        <th onclick="sortTable(1)" class="center">Ngày tạo</th>
                        <th onclick="sortTable(2)" class="center">Tổng tiền</th>
                        <th onclick="sortTable(3)" class="center">Phương thức thanh toán</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.receiptList)
                    {
                        <tr>
                            <td scope="row">@Html.DisplayFor(modelItem => item.ID_Receipt)</td>
                            <td class="center">@Html.DisplayFor(modelItem => item.Create_Date)</td>
                            <td class="right">@Html.DisplayFor(modelItem => item.Total_Price)</td>
                            <td>@Html.DisplayFor(modelItem => item.Payment_Methods)</td>
                        </tr>
                    }
                </tbody>
            </table>

            <div class="pagination" id="pagination1">
                <!-- Nút phân trang sẽ được tạo ở đây -->
            </div>
        </div>
        <div class="carouselTables" id="t2">
            <div class="form-group row">
                <div class="col-sm-4">
                    <label for="fromdte" class="col-form-label">Từ ngày</label>
                    <input type="text" class="form-control" id="fromdte" name="fromdte" placeholder="Select date" required>
                </div>
                <div class="col-sm-4">
                    <label for="todte" class="col-form-label">Đến ngày</label>
                    <input type="text" class="form-control" id="todte" name="todte" placeholder="Select date" required>
                </div>
                <div class="col-sm-4">
                    <!-- Empty column for alignment -->
                </div>
            </div>
            <div class="text-center">
                <button type="submit" class="btn btn-primary" style="margin-bottom: 10px;" onclick="fillterDate('t2', 'table2');">Tìm kiếm</button>
            </div>

            <table class="table" id="table2">
                <thead class="thead-dark">
                    <tr>
                        <th onclick="sortTable(1)" class="center">Mã hóa đơn</th>
                        <th onclick="sortTable(5)" class="center">Ngày tạo</th>
                        <th onclick="sortTable(2)" class="center">Món ăn</th>
                        <th onclick="sortTable(3)" class="center">Nhân viên</th>
                        <th onclick="sortTable(4)" class="center">Số lượng</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.receiptEmployeeModelList)
                    {
                        <tr>
                            <td>@Html.DisplayFor(modelItem => item.ID)</td>
                            <td class="center">@Html.DisplayFor(modelItem => item.Create_Date)</td>
                            <td>@Html.DisplayFor(modelItem => item.Dish_Name)</td>
                            <td>@Html.DisplayFor(modelItem => item.Emp_Name)</td>
                            <td class="right">@Html.DisplayFor(modelItem => item.Quantity)</td>
                        </tr>
                    }
                </tbody>
            </table>

            <div class="pagination" id="pagination2">
                <!-- Nút phân trang sẽ được tạo ở đây -->
            </div>
        </div>
    </div>

    @* --------------- Set value mặc định là ngày hiện tại --------------- *@
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>

    <script src="~/js/History.js"></script>
</div>