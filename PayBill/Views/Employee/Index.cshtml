@model PayBill.Models.GetDataToViewModel;
@using X.PagedList.Mvc.Core;
@{
    ViewData["Title"] = "Privacy Policy";
}

<link rel="stylesheet" href="~/css/Employee.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/site.css" />

<div>
    <div class="con">
        <asp:Label class="lblMesSuc animeSuc" Visible="false"></asp:Label>
    </div>
    <h1>Danh sác nhân viên</h1>
    <table id="dataGrid" class="dataGrid">
        <thead>
            <tr>
                <th onclick="sortTable(0)">ID</th>
                <th onclick="sortTable(1)">Bàn</th>
                <th onclick="sortTable(2)">Chi tiết</th>
            </tr>
        </thead>
        <tbody>
            @for (int i = 0; i < Model.employeeList.Count(); i++)
            {
                var tableClass = "dataGridPopup" + i;
                var desk = @Html.DisplayFor(modelItem => Model.employeeList[i].Employee_Name);
                var id = @Html.DisplayFor(modelItem => Model.employeeList[i].ID_Employee);
                <tr>
                    <td>@Html.DisplayFor(modelItem => Model.employeeList[i].ID_Employee)</td>
                    <td>@Html.DisplayFor(modelItem => Model.employeeList[i].Employee_Name)</td>
                    <td><button id="tbl" type="button" class="button" onclick="openPopup('@tableClass', '@desk');" data-table="@id">Chi tiết</button></td>
                </tr>
            }
        </tbody>
    </table>
</div>

<div class="backdrop" id="backdrop" onclick="closePopup()">
    <h3 class="titleBackdrop"></h3>
</div>
<div class="conErr">
    <asp:Label class="lblMesErr animeErr" Visible="false"></asp:Label>
</div>

<div class="popup" id="popup">
    @for (int i = 0; i < Model.employeeList.Count(); i++)
    {
        var tableClass = "dataGridPopup" + i;
        <table id="dataGridPopup" class="@tableClass" style="width: 100%;">
            <thead class="thead-light">
                <tr>
                    <th onclick="sortTablePopup(0)">ID</th>
                    <th onclick="sortTablePopup(1)">Tên món</th>
                    <th onclick="sortTablePopup(2)">Giá</th>
                    <th onclick="sortTablePopup(3)">Số lượng</th>
                    <th onclick="sortTablePopup(4)">Thành tiền</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.dishesList)
                {
                    <tr>
                        <td>@Html.DisplayFor(modelItem => item.ID_Dish)</td>
                        <td>@Html.DisplayFor(modelItem => item.Dish_Name)</td>
                        <td><span class="price">@Html.DisplayFor(modelItem => item.Dish_Price)</span>đ</td>
                        <td>
                            <div class="counter-container">
                                <button class="decrement">-</button>
                                <span class="number">0</span>
                                <button class="increment">+</button>
                            </div>
                        </td>
                        <td><span class="total">0</span>đ</td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr>
                    <td class="left"></td>
                    <td class="center"></td>
                    <td class="center"></td>
                    <td class="right">Tổng thanh toán</td>
                    <td><span class="bill">0</span>đ</td>
                </tr>
                <tr>
                    <td class="pay">
                        <input type="hidden" id="htmlInput" name="html" value="" />
                        <input type="hidden" id="billInput" name="billInput" value="">
                        <input type="hidden" id="idTable" name="idTable" value="">
                        <input type="hidden" id="paymentMethod" name="paymentMethod" value="">
                    </td>
                    <td class="pay"></td>
                    <td class="pay"></td>
                    <td class="paymentMethods">
                        <div class="divMethod">
                            <div id="1" class="chose fa-solid fa-wallet"><p class="hover-content">Tiền mặt</p></div>
                            <div id="2" class="chose fa-solid fa-money-bill-wave"><p class="hover-content">Chuyển khoản</p></div>
                            <div id="3" class="chose fa-regular fa-credit-card"><p class="hover-content">Credit Card</p></div>
                        </div>
                    </td>
                    <td class="pay"><button id="pay" type="submit" class="button" style="text-align: right;" data-table="@i">Thanh toán</button></td>
                </tr>
            </tfoot>
        </table>
    }
</div>

<!-- Button to navigate to Create page -->
<a asp-action="Create" class="button mt-3">Thêm Nhân Viên</a>
<script src="~/js/Employee.js" asp-append-version="true"></script>