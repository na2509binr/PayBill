@model PayBill.Models.Dish
@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
}

<h1>Create Spending</h1>

<form asp-action="Create" method="post">
    <!-- Dish Name -->
    <div class="form-group">
        <label asp-for="Dish_Name" class="control-label"></label>
        <input asp-for="Dish_Name" class="form-control" />
        <span asp-validation-for="Dish_Name" class="text-danger"></span>
    </div>

    <!-- Is For Employee -->
    <div class="form-group">
        <label class="control-label">Dành cho nhân viên</label>
        <div class="form-check">
            <input asp-for="Is_For_Employee" class="form-check-input" type="radio" value="1" id="yes" />
            <label class="form-check-label" for="yes">Có</label>
        </div>
        <div class="form-check">
            <input asp-for="Is_For_Employee" class="form-check-input" type="radio" value="0" id="no" />
            <label class="form-check-label" for="no">Không</label>
        </div>
        <span asp-validation-for="Is_For_Employee" class="text-danger"></span>
    </div>

    <!-- Dish Price -->
    <div class="form-group">
        <label asp-for="Dish_Price" class="control-label"></label>
        <input asp-for="Dish_Price" class="form-control" type="number" step="1" />
        <span asp-validation-for="Dish_Price" class="text-danger"></span>
    </div>

    <!-- Submit Button -->
    <div class="form-group">
        <input type="submit" value="Submit" class="button" />
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
