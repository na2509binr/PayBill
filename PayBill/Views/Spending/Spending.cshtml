@model PayBill.Models.Spending

@{
    ViewData["Title"] = "Create Spending";
    // Set the default value for CreateTime to the current date and time
    var currentDateTime = DateTime.Now.ToString("yyyy-MM-ddTHH:mm"); // Format for datetime-local input
}

<h1>Create Spending</h1>

<form asp-action="Create" method="post">
    <div class="form-group">
        <label asp-for="SpendingType" class="control-label"></label>
        <select asp-for="SpendingType" class="form-control">
            @foreach (var type in Enum.GetValues(typeof(PayBill.Models.SpendingType)))
            {
                <option value="@type">@type</option>
            }
        </select>
        <span asp-validation-for="SpendingType" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="Spending_Amount" class="control-label"></label>
        <input asp-for="Spending_Amount" class="form-control" />
        <span asp-validation-for="Spending_Amount" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="Spending_Value" class="control-label"></label>
        <input asp-for="Spending_Value" class="form-control" />
        <span asp-validation-for="Spending_Value" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="CreateTime" class="control-label"></label>
        <input asp-for="CreateTime" class="form-control" type="datetime-local" value="@currentDateTime" readonly />
        <span asp-validation-for="CreateTime" class="text-danger"></span>
    </div>
    <div class="form-group">
        <input type="submit" value="Submit" class="btn btn-primary" />
    </div>
</form>